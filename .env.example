# Copy to .env and replace every value locally. Never place real secrets here.
DEPLOY_PROTOCOL=ftp-or-sftp
DEPLOY_HOST=example.invalid
DEPLOY_PORT=21-or-22
DEPLOY_USERNAME=your-username
DEPLOY_PASSWORD=your-password
DEPLOY_REMOTE_PATH=/absolute/remote/path

# Private canonical /lab/ access code. The deploy script derives and uploads
# only a salted PBKDF2 verifier; the plaintext value is never published.
LAB_ACCESS_PASSWORD=choose-at-least-12-characters
